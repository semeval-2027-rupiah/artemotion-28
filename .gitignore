# Derived model artifacts -- regenerate from the baseline code instead.
# Several of these exceed GitHub's 100 MiB per-file hard limit.
*.pt
*.pth
*.ckpt
*.npy
*.npz
*.h5
*.pkl

*.safetensors

# Run outputs: checkpoints and per-row predictions stay local.
# Only the summaries in analysis/out/ (json/md) are committed.
checkpoints/
baselines/*/checkpoints/
baselines/*/results/
analysis/out/**/*.csv

# Archives
*.zip
*.tar
*.tar.gz

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# OS
.DS_Store
Thumbs.db
